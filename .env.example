# InterJudaica Web — Environment Variables
# Copy this file to .env and fill in your values

# ─── MongoDB ───────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
# MONGODB_URI=mongodb://localhost:27017        # fallback
# MONGO_URI=mongodb://localhost:27017          # fallback
MONGODB_NAME=interjudaica
# MONGODB_DATABASE=interjudaica                # fallback
# MONGO_DB=interjudaica                        # fallback

# ─── Auth ──────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
# NEXTAUTH_SECRET=                             # fallback

# ─── App ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3025

# ─── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (email) ────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=InterJudaica <noreply@interjudaica.com>

# ─── DeepSeek AI ───────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # default

# ─── OpenAI (translations) ─────────────────────────────
# OPENAI_API_KEY=sk-...                          # optional
# AI_API_KEY=sk-...                              # fallback
# AI_MODEL=gpt-4o-mini                           # default

# ─── Cloudflare Turnstile (CAPTCHA) ─────────────────────
# TURNSTILE_SECRET_KEY=1x...                     # optional, no CAPTCHA if unset in dev

# ─── Rate Limiting — Verify Email ──────────────────────
# VERIFY_RESEND_COOLDOWN_SECONDS=30              # default
# VERIFY_RESEND_WINDOW_SECONDS=600               # default
# VERIFY_RESEND_LIMIT=3                          # default
# NEXT_PUBLIC_VERIFY_RESEND_COOLDOWN_SECONDS=30  # default

# ─── Rate Limiting — Reset Password ────────────────────
# RESET_RESEND_COOLDOWN_SECONDS=60               # default
# RESET_RESEND_WINDOW_SECONDS=600                # default
# RESET_RESEND_LIMIT=5                           # default
# RESET_ATTEMPT_LIMIT=5                          # default
# RESET_ATTEMPT_WINDOW_SECONDS=900               # default
# RESET_ATTEMPT_LOCK_SECONDS=900                 # default
# NEXT_PUBLIC_RESET_RESEND_COOLDOWN_SECONDS=60   # default
